# Public browser configuration (Supabase publishable/anon key only).
# Leave both empty for fully functional device-local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# GitHub project Pages: /your-repository-name/ ; root hosting: /
VITE_BASE_PATH=/
# OPENAI_API_KEY belongs in Supabase Edge Function secrets, NEVER a VITE_ variable.
